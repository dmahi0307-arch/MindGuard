{
  "": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/mindwell/(.*)",
      "destination": "/mindwell/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}