{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/mindwell/(.*)",
      "destination": "/mindwell/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
